# Coming_Soon_page environment config — copy to ".env" on the server and fill in.
# The real .env is gitignored (never commit secrets). This file documents the
# required keys so a redeploy/rename never silently loses configuration again.
#
# When pasting KIT_API_SECRET / SMTP_PASS, use the provider's Copy button and
# verify the length — a single dropped character makes the whole value invalid.

# --- MySQL (Hostinger) ---
DB_USER=
DB_PASS=
DB_NAME=

# --- Kit / ConvertKit (subscriber tagging by language) ---
KIT_API_SECRET=

# --- SMTP (waitlist welcome email via PHPMailer) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
