<Files .env>
    Order allow,deny
    Deny from all
</Files>

# Block web access to log files (e.g. kit_errors.log) and env files.
<FilesMatch "\.(log|env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

php_flag display_errors Off

RewriteEngine On

# Clean URL rewrites
RewriteRule ^en/?$ index.html [L]
RewriteRule ^ar/?$ index_ar.html [L]

# Redirect root to /en
RewriteRule ^$ /en [R=301,L]
