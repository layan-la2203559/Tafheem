# Supabase project: wgzumfwrihavmwbaswnv
# Get these from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kit / ConvertKit (newsletter — subscribe + language tag on signup)
# Same secret as the landing page. Get it from kit.com -> Settings -> Advanced -> API.
KIT_API_SECRET=

# Resend (custom transactional email sent by the app). SECRET — server only.
# Get the key from resend.com -> API Keys.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Optional: base URL used in auth email redirects (e.g. https://staging.tafheem.io)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Staging gate (HTTP Basic Auth via middleware.ts). Set BOTH only on the
# staging deploy (staging.tafheem.io) to password-protect the in-progress MVP.
# Leave BLANK on production and local dev so they are never locked out.
STAGING_USER=
STAGING_PASS=
